# Cashflow environment variables. Copy to .env.local for local dev; set the same in Vercel
# (Production + Preview). NEXT_PUBLIC_* reach the browser. Never commit .env.local.

# Required: Cashflow's OWN Supabase project (never the KinBird project).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Recommended: the public origin (custom domain once you have one).
NEXT_PUBLIC_SITE_URL=

# Optional: phone sign-in ("whatsapp" or "sms"). Leave unset until the Supabase Phone provider is on.
NEXT_PUBLIC_PHONE_AUTH=

# Optional: set to 1 to show "Continue with Google" once the Google provider is on in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=
